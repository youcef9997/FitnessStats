<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             x:Class="assessment2526.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="SettingsPage">

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="25">

                <!-- HEADER -->
                <Label Text="Settings" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />
            
            <!-- THEME CARD -->
            <Border BackgroundColor="{DynamicResource CardColor}"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Appearance"
                           FontSize="18"
                           HorizontalOptions="Center"/>
                   
                    <Border BackgroundColor="{DynamicResource PrimaryColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <!-- Selected value -->
                            <Label Text="{Binding SelectedTheme}"
                                   VerticalOptions="Center"
                                   FontSize="16"/>
                           
                            <!-- Dropdown arrow -->
                            <Label Text="▼"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   FontSize="14" />
                                                      
                            <!-- Hidden Picker on top -->
                            <Picker ItemsSource="{Binding Themes}"
                                    SelectedItem="{Binding SelectedTheme}"
                                    Opacity="0.01"
                                    Grid.ColumnSpan="2" />
                        </Grid>
                    </Border>

                    <!-- AUTO PAUSE SETTING -->
                    <Border BackgroundColor="{DynamicResource PrimaryColor}"
                            StrokeShape="RoundRectangle 15"
                            Padding="15">

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10">

                            <Label Text="Auto Pause"
                                   FontSize="18"
                                   Grid.Row="0"
                                   Grid.Column="0" />

                            <Switch IsToggled="{Binding IsAutoPauseEnabled}"
                                    Grid.Row="0"
                                    Grid.Column="1" />

                            <Label Text="Automatically pause the run when no movement is detected."
                                   FontSize="13"
                                   Opacity="0.7"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2" />

                        </Grid>
                    </Border>


                </VerticalStackLayout>
            
            </Border>
                
        
       </VerticalStackLayout>
        
  </ScrollView>
    
    </ContentPage>