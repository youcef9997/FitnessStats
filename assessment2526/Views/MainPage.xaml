<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="assessment2526.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <Label 
        Text="MyFitnessStats"
        FontSize="32"
        HorizontalOptions="Center"/>

            <Button 
        Text="Start Run"
        TextColor="White"
        FontSize="20"
        HeightRequest="60"
        BackgroundColor="Grey"/>

            <Button 
        Text="View History"
        TextColor="White"
        FontSize="20"
        HeightRequest="60"
        BackgroundColor="Grey"/>

            <Button 
        Text="Settings"
        TextColor="White"
        FontSize="20"
        HeightRequest="60"
        BackgroundColor="Grey"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
