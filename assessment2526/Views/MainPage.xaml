<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             x:Class="assessment2526.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <Label  Text="MyFitnessStats"
                    FontSize="32"
                    HorizontalOptions="Center"
                    FontAttributes="Bold" />

            <!-- card view-->
            <Border BackgroundColor="{StaticResource CardColor}"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label  Text="Ready to start your run?"
                            FontSize="18"
                            TextColor="White"
                            HorizontalOptions="Center" />

                    <Button Text="Start Run"
                            Command="{Binding StartRunCommand}" />

                    <Button Text="View History"/>
                    <Button Text="Settings"/>
                </VerticalStackLayout>

            </Border>

            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
