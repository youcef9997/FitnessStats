<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="assessment2526.Views.TrackingPage"
             x:DataType="vm:TrackingViewModel"
             Title="TrackingPage"
             BackgroundColor="{StaticResource BackgroundColor}">



    <CarouselView>
        <CarouselView.ItemsSource>
            <x:Array Type="{x:Type View}">

                <!-- PAGE 1 -->
                <ContentView>
                    <VerticalStackLayout Padding="20" Spacing="20">

                        <!-- TIME -->
                        <Border BackgroundColor="{StaticResource CardColor}"
                            StrokeShape="RoundRectangle 25"
                            Padding="25">
                            <Label Text="{Binding TimeText}"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        </Border>

                        <!-- GRID -->
                        <Grid ColumnDefinitions="*,*">

                            <Border Grid.Column="0"
                                BackgroundColor="{StaticResource CardColor}"
                                StrokeShape="RoundRectangle 20"
                                Margin="5">
                                <VerticalStackLayout Padding="15">
                                    <Label Text="Distance"/>
                                    <Label Text="{Binding DistanceText}" FontSize="28"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                BackgroundColor="{StaticResource CardColor}"
                                StrokeShape="RoundRectangle 20"
                                Margin="5">
                                <VerticalStackLayout Padding="15">
                                    <Label Text="Speed"/>
                                    <Label Text="{Binding SpeedText}" FontSize="28"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Label Text="{Binding StatusText}"
                           HorizontalOptions="Center"/>

                        <Border BackgroundColor="{StaticResource CardColor}"
                            StrokeShape="RoundRectangle 20"
                            Padding="15">
                            <VerticalStackLayout>
                                <Button Text="Start Run"
                                    Command="{Binding StartCommand}"/>
                                <Button Text="Stop Run"
                                    Command="{Binding StopCommand}"
                                    BackgroundColor="Red"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ContentView>

                <!-- PAGE 2 with full map -->
                <ContentView>
                    <Grid>
                        <maps:Map x:Name="MapView"
                              IsShowingUser="True"/>
                    </Grid>
                </ContentView>

            </x:Array>
        </CarouselView.ItemsSource>
    </CarouselView>

</ContentPage>
    

