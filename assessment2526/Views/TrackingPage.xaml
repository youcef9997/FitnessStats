<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="assessment2526.Views.TrackingPage"
             x:DataType="vm:TrackingViewModel"
             Title="TrackingPage">
    
    <ScrollView>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

            <Button Text="Stats"
            Grid.Column="0"
            Command="{Binding ShowStatsCommand}" />

            <Button Text="Map"
            Grid.Column="1"
            Command="{Binding ShowMapCommand}" />

            <Button Text="Compass"
            Grid.Column="2"
            Command="{Binding ShowCompassCommand}" />

        </Grid>

        <!--STATS VIEW -->
        <VerticalStackLayout IsVisible="{Binding IsStatsVisible}"
                                 Spacing="20">

            <Border BackgroundColor="{StaticResource CardColor}"
                    StrokeShape="RoundRectangle 25"
                    Padding="25">

                <Label Text="{Binding TimeText}"
                       TextColor="{DynamicResource TextColor}"
                       FontSize="48"
                       HorizontalOptions="Center"/>

            </Border>

            <Label Text="{Binding StatusText}"
                   TextColor="{DynamicResource TextColor}"
                   HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*,*">

                <Border Grid.Column="0" BackgroundColor="{StaticResource CardColor}">
                    <VerticalStackLayout Padding="15">

                        <Label Text="Distance"/>

                        <Label Text="{Binding DistanceText}" 
                                   TextColor="{DynamicResource TextColor}"
                                   FontSize="28"/>

                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="{StaticResource CardColor}">
                    <VerticalStackLayout Padding="15">

                        <Label Text="Speed"/>

                        <Label Text="{Binding SpeedText}" 
                                   TextColor="{DynamicResource TextColor}"
                                   FontSize="28"/>

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Button Text="Start Run" 
                        Command="{Binding StartCommand}"/>

            <Button Text="{Binding PauseButtonText}"
                        Command="{Binding PauseResumeCommand}"/>

            <Button Text="Stop Run"
                        Command="{Binding StopCommand}"
                        BackgroundColor="Red"/>

        </VerticalStackLayout>

        <!-- MAP VIEW -->
        <Grid IsVisible="{Binding IsMapVisible}">

            <maps:Map IsShowingUser="True"/>

        </Grid>

        <VerticalStackLayout IsVisible="{Binding IsCompassVisible}"
                     Spacing="20">

            <Border StrokeShape="RoundRectangle 25"
            Padding="25">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Compass"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

                    <Label Text="{Binding CompassHeadingText}"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Current compass heading in degrees" />

                    <Label Text="{Binding CompassDirectionText}"
                   FontSize="{DynamicResource SubtitleFontSize}"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Current compass direction" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
