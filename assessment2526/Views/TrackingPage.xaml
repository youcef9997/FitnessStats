<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             x:Class="assessment2526.Views.TrackingPage"
             Title="TrackingPage">
    <VerticalStackLayout Padding="25" Spacing="20">
      <Label 
            Text="Tracking Your Run"
            TextColor="White"
            FontSize="32"
            HorizontalOptions="Center"
            BackgroundColor="Grey"/>
        
        <!-- Time -->
        <Border Padding="15" 
                StrokeThickness="1">
            <Label Text="{Binding TimeText}"
                   FontSize="20"
                   TextColor="White"
                   BackgroundColor="Grey"/>
        </Border>

        <!-- Distance -->
        <Border Padding="15" 
                StrokeThickness="1">
            <Label Text="{Binding DistanceText}"
                   FontSize="20" 
                   TextColor="White"
                   BackgroundColor="Grey"/>
        </Border>

        <!-- Speed -->
        <Border Padding="15" 
                StrokeThickness="1">
            <Label Text="{Binding SpeedText}" 
                   FontSize="20"
                   TextColor="White"
                   BackgroundColor="Grey"/>
        </Border>

        <!-- Status -->
        <Label 
            Text="{Binding StatusText}"
            HorizontalOptions="Center"
            TextColor="White"
            BackgroundColor="Grey"/>

        <!-- Buttons -->
        <Button 
            Text="Start Run"
            Command="{Binding StartCommand}"
            TextColor="White"
            BackgroundColor="Grey"
            HeightRequest="60"
            FontSize="20"/>

        <Button 
            Text="Stop Run"
            Command="{Binding StopCommand}"
            HeightRequest="60"
            FontSize="20"
            TextColor="Black"
            BackgroundColor="Red"/>

    </VerticalStackLayout>
</ContentPage>