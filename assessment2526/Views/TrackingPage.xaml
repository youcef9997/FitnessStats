<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="assessment2526.Views.TrackingPage"
             x:DataType="vm:TrackingViewModel"
             Title="TrackingPage">

    <VerticalStackLayout Padding="25" Spacing="20"
                         BackgroundColor="{StaticResource BackgroundColor}">

        <maps:Map 
            x:Name="MapView"
            HeightRequest="300"
            IsShowingUser="True"/>

        <Label 
            Text="Tracking Your Run"
            TextColor="White"
            FontSize="32"
            HorizontalOptions="Center"/>
        
        <!-- Time -->
        <Border Padding="15" 
                BackgroundColor="{StaticResource CardColor}">
            <Label Text="{Binding TimeText}"
                   FontSize="20"
                   TextColor="White"/>
        </Border>

        <!-- Distance -->
        <Border Padding="15" 
                StrokeThickness="1">
            <Label Text="{Binding DistanceText}"
                   FontSize="20" 
                   TextColor="White"/>
        </Border>

        <!-- Speed -->
        <Border Padding="15" 
                StrokeThickness="1">
            <Label Text="{Binding SpeedText}" 
                   FontSize="20"
                   TextColor="White"/>
        </Border>

        <!-- Status -->
        <Label 
            Text="{Binding StatusText}"
            HorizontalOptions="Center"
            TextColor="White"/>

      <Border BackgroundColor="{StaticResource CardColor}"
        StrokeShape="RoundRectangle 20"
        Padding="20">

        <VerticalStackLayout Spacing="15">

                <!-- Buttons -->
          <Button Text="Start Run"
                  Command="{Binding StartCommand}"/>

            <Button Text="Stop Run"
                    Command="{Binding StopCommand}"
                    BackgroundColor="Red"/>
        </VerticalStackLayout>

      </Border>

    </VerticalStackLayout>
</ContentPage>